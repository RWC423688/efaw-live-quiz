rules_version = '2';
// Security rules for the EFAW Live Quiz (DM Learning).
// Paste into Firebase console > Firestore Database > Rules, then Publish.
//
// - Trainers: accounts listed in the "trainers" collection (added by hand in the console).
// - Candidates: anonymous sign-in. They can join a session, answer the CURRENT question once,
//   answer their own catch-up questions, and read only their own answers.
// - Highfield: papers, answer keys and the answer-sheet template are trainer-only. A Highfield
//   candidate can read the running paper's questions (never the key) and save their own answers
//   only while the paper is open and until they submit.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isTrainer() {
      return signedIn() && exists(/databases/$(database)/documents/trainers/$(request.auth.uid));
    }

    match /trainers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Highfield material: trainer-only
    match /hfPapers/{paperId} {
      allow read, write: if isTrainer();
    }
    match /hfTemplates/{tplId} {
      allow read, write: if isTrainer();
    }

    match /sessions/{code} {
      function sess() { return get(/databases/$(database)/documents/sessions/$(code)).data; }
      function player(uid) { return get(/databases/$(database)/documents/sessions/$(code)/players/$(uid)).data; }
      function isHFPlayer(uid) {
        return exists(/databases/$(database)/documents/sessions/$(code)/players/$(uid))
          && player(uid).get('track', '') == 'highfield';
      }

      allow get: if signedIn();
      allow list, create, update, delete: if isTrainer();

      match /players/{uid} {
        allow get: if isTrainer() || (signedIn() && request.auth.uid == uid);
        allow list, delete: if isTrainer();
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'joinedAt', 'lastSeen', 'track', 'dob'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.get('track', 'dm') in ['dm', 'highfield']
          && request.resource.data.get('dob', '') is string
          && request.resource.data.get('dob', '').size() <= 10
          && sess().status != 'ended';
      }

      match /answers/{aid} {
        allow read: if isTrainer() || (signedIn() && resource.data.uid == request.auth.uid);
        allow delete: if isTrainer();
        allow update: if false;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && aid == request.auth.uid + '_' + request.resource.data.qid
          && request.resource.data.keys().hasOnly(['uid', 'qid', 'choice', 'at', 'retest'])
          && request.resource.data.choice is int
          && request.resource.data.choice >= 0 && request.resource.data.choice <= 3
          && exists(/databases/$(database)/documents/sessions/$(code)/players/$(request.auth.uid))
          && (
            (sess().status == 'question' && request.resource.data.retest == false
              && sess().q.qid == request.resource.data.qid)
            ||
            (sess().status == 'retest' && request.resource.data.retest == true
              && request.resource.data.qid in get(/databases/$(database)/documents/sessions/$(code)/retests/$(request.auth.uid)).data.qids)
          );
      }

      match /retests/{uid} {
        allow get: if isTrainer() || (signedIn() && request.auth.uid == uid);
        allow list, write: if isTrainer();
      }

      // The running Highfield paper (questions only, copied in by the trainer when the paper starts)
      match /hf/{docId} {
        allow get: if isTrainer()
          || (signedIn() && sess().status == 'paper' && isHFPlayer(request.auth.uid));
        allow list, write: if isTrainer();
      }

      // A Highfield candidate's paper answers
      // Copy of the trainer's signature for this session's certificates. Readable only by people who joined the session.
      match /meta/{docId} {
        allow get: if isTrainer() || (signedIn() && exists(/databases/$(database)/documents/sessions/$(code)/players/$(request.auth.uid)));
        allow list, create, update, delete: if isTrainer();
      }

      match /hfAnswers/{uid} {
        allow get: if isTrainer() || (signedIn() && request.auth.uid == uid);
        allow list, delete: if isTrainer();
        allow create, update: if signedIn() && request.auth.uid == uid
          && sess().status == 'paper'
          && isHFPlayer(uid)
          && (resource == null || resource.data.get('submitted', false) != true)
          && request.resource.data.keys().hasOnly(['answers', 'startedAt', 'updatedAt', 'submitted', 'submittedAt', 'signature'])
          && (!('signature' in request.resource.data) || (request.resource.data.signature is string && request.resource.data.signature.size() < 200000))
          && request.resource.data.answers is map
          && request.resource.data.answers.size() <= 15
          && request.resource.data.submitted is bool;
      }
    }
  }
}
